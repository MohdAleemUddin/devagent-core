# Local development settings. Do not use the example password outside a
# machine-local development environment.
PROJECT_NAME="DevAgent Core"
API_V1_STR="/api/v1"
DEBUG=false

# Matches the host port exposed by docker-compose.yaml.
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=devagent_db
POSTGRES_PORT=5433

# LLM Settings
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=llama3.2:3b
